# Database: Cloudflare D1 (binding DB) — no URL needed. Local D1 lives in .wrangler/ (pnpm db:migrate).
STREAMING_AVAILABILITY_API_KEY=
# Optional: RapidAPI host instead of https://api.movieofthenight.com/v4
STREAMING_AVAILABILITY_API_URL=
TMDB_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=
TELEGRAM_BOT_TOKEN=
CRON_SECRET=
# Deployed /api/setup (migrations + demo data). Set as a Sites secret, never commit.
SETUP_TOKEN=
# Admin (/admin) — HTTP Basic auth. Unset in production → /admin is 404.
ADMIN_USER=
ADMIN_PASSWORD=
# Alerts: Telegram bot (dispatcher dry-runs without a token); signs subscribe links.
TELEGRAM_BOT_USERNAME=
ALERTS_SECRET=
# Dev only: extra origins allowed to load the dev server (e.g. a preview host).
DEV_ALLOWED_ORIGINS=
